{
  "name": "relay-farcaster-client",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "node --env-file-if-exists=.env server/dev.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --import tsx --test test/*.test.ts",
    "test:ui": "playwright test",
    "test-account": "node --import tsx scripts/test-account.mjs",
    "start": "node server/production.mjs"
  },
  "dependencies": {
    "@faker-js/faker": "10.6.0",
    "@farcaster/core": "0.20.0",
    "@scure/bip39": "1.6.0",
    "buffer": "^6.0.3",
    "lucide-react": "^1.59.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "viem": "^2.57.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "overrides": {
    "@faker-js/faker": "10.6.0"
  }
}
